def _save_installment_plan_v111(
    user_id,
    *,
    plan_type,
    provider_name,
    description,
    original_amount,
    total_installments,
    next_due_date,
    payment_method_id,
    category_id=None,
    tag_ids=None,
    purchase_date=None,
    completed_installments=0,
    remaining_balance=None,
    installment_amount=None,
    annual_interest_rate=0,
    fees_total=0,
    frequency_unit="month",
    frequency_interval=1,
    budget_excluded=False,
    note=None,
    plan_id=None,
):
    """Délègue avec les dépendances courantes de finances_data."""
    return _financing_writes._save_installment_plan_v111(
        user_id,
        plan_type=plan_type,
        provider_name=provider_name,
        description=description,
        original_amount=original_amount,
        total_installments=total_installments,
        next_due_date=next_due_date,
        payment_method_id=payment_method_id,
        category_id=category_id,
        tag_ids=tag_ids,
        purchase_date=purchase_date,
        completed_installments=completed_installments,
        remaining_balance=remaining_balance,
        installment_amount=installment_amount,
        annual_interest_rate=annual_interest_rate,
        fees_total=fees_total,
        frequency_unit=frequency_unit,
        frequency_interval=frequency_interval,
        budget_excluded=budget_excluded,
        note=note,
        plan_id=plan_id,
        FREQUENCY_UNITS=FREQUENCY_UNITS,
        INSTALLMENT_PLAN_TYPES=INSTALLMENT_PLAN_TYPES,
        _automatic_installment_amount=_automatic_installment_amount,
        _decimal_value=_decimal_value,
        _money=_money,
        _optional_date_value=_optional_date_value,
        _rebuild_installment_transactions=_rebuild_installment_transactions,
        _text=_text,
        _validate_links=_validate_links,
        _validate_payment_method=_validate_payment_method,
        analyze_installment_progress=analyze_installment_progress,
        get_connection=get_connection,
    )


