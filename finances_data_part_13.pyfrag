        transaction_type=transaction_type,
        fallback_description=fallback_description,
        fallback_amount=fallback_amount,
        fallback_start=fallback_start,
        fallback_end=fallback_end,
        payload=payload,
        _text=_text,
        _money=_money,
        _optional_date_value=_optional_date_value,
        _normalize_reminder_time=_normalize_reminder_time,
        _validate_links=_validate_links,
        _validate_payment_method=_validate_payment_method,
        FREQUENCY_UNITS=FREQUENCY_UNITS,
