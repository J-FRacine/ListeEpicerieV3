    }
    .jf-finance-history-column + .jf-finance-history-column {
        border-left: 0;
        border-top: 1px solid var(--jf-border);
    }
}
@media (max-width: 430px) {
    .jf-finance-main-tabs .q-tab {
        min-height: 2.85rem;
        padding-inline: .58rem;
    }
    .jf-finance-main-tabs .q-tab__label {
